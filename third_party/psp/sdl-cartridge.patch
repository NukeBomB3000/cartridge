 /* The general mixing thread function */
+/* cartridge: the volume of the handheld. A script keeps the level (0..100) in /run/cartridge-volume;
+ * what a program plays is scaled by its square, as cartridge does with its own sound. */
+#include <fcntl.h>
+#include <unistd.h>
+
+static float cartridge_gain(void)
+{
+    static int tick;
+    static float gain = 1.0f;
+    if ((tick++ & 7) == 0) {
+        char text[16] = { 0 };
+        int fd = open("/run/cartridge-volume", O_RDONLY | O_CLOEXEC);
+        if (fd >= 0) {
+            if (read(fd, text, sizeof(text) - 1) > 0) {
+                int v = SDL_atoi(text);
+                v = v < 0 ? 0 : v > 100 ? 100 : v;
+                gain = (float)(v * v) / 10000.0f;
+            }
+            close(fd);
+        } else {
+            gain = 1.0f;
+        }
+    }
+    return gain;
+}
+
+static void cartridge_scale(Uint8 *data, int len, SDL_AudioFormat format)
+{
+    const float gain = cartridge_gain();
+    int i;
+    if (gain >= 1.0f) {
+        return;
+    }
+    if (format == AUDIO_S16SYS) {
+        Sint16 *s = (Sint16 *)data;
+        for (i = 0; i < len / 2; i++) {
+            s[i] = (Sint16)((float)s[i] * gain);
+        }
+    } else if (format == AUDIO_F32SYS) {
+        float *f = (float *)data;
+        for (i = 0; i < len / 4; i++) {
+            f[i] *= gain;
+        }
+    } else if (format == AUDIO_S32SYS) {
+        Sint32 *s = (Sint32 *)data;
+        for (i = 0; i < len / 4; i++) {
+            s[i] = (Sint32)((double)s[i] * gain);
+        }
+    }
+}
+
